{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://best-ui-ux-designers.org/schemas/design-md-v1.0.0.json",
  "title": "DESIGN.md Canonical Frontmatter Schema v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "regime_fit",
    "high_weight_signals",
    "hard_filters",
    "veto_triggers",
    "concrete_heuristics",
    "blind_spots",
    "debate_triggers",
    "primary_sources",
    "markdown_contract"
  ],
  "$defs": {
    "regime_enum": {
      "type": "string",
      "enum": [
        "ai_native_desktop_ide",
        "saas_b2b_intensive",
        "mobile_consumer_capture",
        "analytics_dense_telemetry",
        "landing_onboarding_conversion"
      ]
    },
    "roster_slug": {
      "type": "string",
      "enum": [
        "dieter-rams",
        "don-norman",
        "edward-tufte",
        "jef-raskin",
        "ben-shneiderman",
        "susan-kare",
        "bret-victor",
        "karri-saarinen",
        "luke-wroblewski",
        "rasmus-andersson",
        "rauno-freiberg",
        "agentic-flow-architect"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "display_name",
        "barbell_pole",
        "archetype_synthetic",
        "primary_domain",
        "core_axiom",
        "active_era",
        "skin_in_the_game_evidence"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 2
        },
        "barbell_pole": {
          "type": "string",
          "enum": ["lindy_anchor", "convex_frontier"]
        },
        "archetype_synthetic": {
          "type": "boolean"
        },
        "primary_domain": {
          "type": "string",
          "minLength": 3
        },
        "core_axiom": {
          "type": "string",
          "minLength": 10,
          "maxLength": 220
        },
        "active_era": {
          "type": "string",
          "minLength": 4
        },
        "skin_in_the_game_evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "year", "verifiable_metric", "source_id"],
            "properties": {
              "artifact": { "type": "string", "minLength": 2 },
              "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
              "verifiable_metric": { "type": "string", "minLength": 5 },
              "source_id": { "type": "string", "pattern": "^src-[0-9]{2}$" }
            }
          }
        }
      }
    },
    "regime_fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_regimes",
        "secondary_regimes",
        "out_of_universe_regimes"
      ],
      "properties": {
        "primary_regimes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/regime_enum" }
        },
        "secondary_regimes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/regime_enum" }
        },
        "out_of_universe_regimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["regime", "reason"],
            "properties": {
              "regime": { "$ref": "#/$defs/regime_enum" },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "high_weight_signals": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "weight",
          "category",
          "detects_before_others",
          "observable_indicator",
          "threshold",
          "direction",
          "source_id"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^sig-[0-9]{2}$" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "weight": { "type": "string", "enum": ["critical", "high", "medium"] },
          "category": {
            "type": "string",
            "enum": [
              "latency_perception",
              "cognitive_load",
              "information_density",
              "interaction_physics",
              "visual_semiotics",
              "agentic_trust",
              "conversion_ergonomics"
            ]
          },
          "detects_before_others": { "type": "string", "minLength": 5 },
          "observable_indicator": { "type": "string", "minLength": 5 },
          "threshold": { "type": ["string", "number", "boolean"] },
          "direction": {
            "type": "string",
            "enum": [
              "lower_is_better",
              "higher_is_better",
              "exact_match",
              "boolean_required"
            ]
          },
          "source_id": { "type": "string", "pattern": "^src-[0-9]{2}$" }
        }
      }
    },
    "hard_filters": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "gate_type", "condition", "failure_impact"],
        "properties": {
          "id": { "type": "string", "pattern": "^flt-[0-9]{2}$" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "gate_type": { "type": "string", "enum": ["required", "disqualifier"] },
          "condition": { "type": "string", "minLength": 5 },
          "failure_impact": { "type": "string", "minLength": 5 }
        }
      }
    },
    "veto_triggers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "severity",
          "target_antipattern",
          "detection_rule",
          "mandatory_remediation"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^veto-[0-9]{2}$" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "severity": { "type": "string", "enum": ["hard_veto", "conditional_block"] },
          "target_antipattern": { "type": "string", "minLength": 5 },
          "detection_rule": { "type": "string", "minLength": 5 },
          "mandatory_remediation": { "type": "string", "minLength": 5 }
        }
      }
    },
    "concrete_heuristics": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_statement",
          "metric_or_bound",
          "verification_method",
          "applies_to",
          "source_id"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^heur-[0-9]{2}$" },
          "rule_statement": { "type": "string", "minLength": 10 },
          "metric_or_bound": { "type": "string", "minLength": 2 },
          "verification_method": {
            "type": "string",
            "enum": [
              "static_code_audit",
              "runtime_telemetry",
              "klm_goms_estimate",
              "visual_dom_inspection",
              "state_matrix_check"
            ]
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/regime_enum" }
          },
          "source_id": { "type": "string", "pattern": "^src-[0-9]{2}$" }
        }
      }
    },
    "blind_spots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "failure_mode", "trigger_context", "counterweight_designer"],
        "properties": {
          "id": { "type": "string", "pattern": "^bs-[0-9]{2}$" },
          "failure_mode": { "type": "string", "minLength": 5 },
          "trigger_context": { "type": "string", "minLength": 5 },
          "counterweight_designer": { "$ref": "#/$defs/roster_slug" }
        }
      }
    },
    "debate_triggers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "opposing_designer",
          "conflict_axis",
          "this_designer_stance",
          "opposing_stance",
          "arbitration_rule"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^dbt-[0-9]{2}$" },
          "opposing_designer": { "$ref": "#/$defs/roster_slug" },
          "conflict_axis": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "this_designer_stance": { "type": "string", "minLength": 5 },
          "opposing_stance": { "type": "string", "minLength": 5 },
          "arbitration_rule": { "type": "string", "minLength": 5 }
        }
      }
    },
    "primary_sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "author_or_org",
          "year",
          "source_type",
          "url_or_identifier",
          "extracted_invariant"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 3 },
          "author_or_org": { "type": "string", "minLength": 2 },
          "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "source_type": {
            "type": "string",
            "enum": [
              "book",
              "peer_reviewed_paper",
              "engineering_post",
              "shipped_oss_repo",
              "primary_talk",
              "official_standard",
              "empirical_benchmark"
            ]
          },
          "url_or_identifier": { "type": "string", "minLength": 3 },
          "extracted_invariant": { "type": "string", "minLength": 5 }
        }
      }
    },
    "markdown_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_sections_order"],
      "properties": {
        "required_sections_order": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            { "const": "1. Operational Worldview" },
            { "const": "2. Regime Boundaries & Out-of-Universe Rationale" },
            { "const": "3. Signal Detection Protocol" },
            { "const": "4. Hard Filters & Veto Playbook" },
            { "const": "5. Executable Heuristics & Code Patterns" },
            { "const": "6. Blind Spots & Counterweights" },
            { "const": "7. Adversarial Debate Positions" },
            { "const": "8. Primary Source Notes" }
          ]
        }
      }
    }
  }
}
