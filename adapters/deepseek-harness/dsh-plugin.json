{
  "schema_version": "1.1.0",
  "ecosystem_contract_version": "1.1.0",
  "name": "best-ui-ux-designers",
  "suite_id": "ui-ux",
  "version": "1.1.0",
  "description": "Portable CPU-first adversarial UI/UX judgment suite (suite_id: ui-ux) combining deterministic uiux_cpu_scanner.py with compact semantic reviews on DeepSeek Harness.",
  "license": "MIT",
  "suite_manifest": "./references/suite.yaml",
  "execution_profile": {
    "modality": "cpu_first_plus_semantic_llm",
    "recommended_models": [
      "deepseek-v4-pro",
      "deepseek-flash"
    ],
    "pre_scanner": "./tools/uiux_cpu_scanner.py",
    "unverified_marker": "UNVERIFIED_MISSING_TOOL",
    "max_operational_brief_bytes": 25600
  },
  "entrypoints": {
    "director": "./SKILL.md",
    "routing_matrix": "./routing-matrix.yaml",
    "pre_scanner": "./tools/uiux_cpu_scanner.py",
    "skills_dir": "./references/skills",
    "auditors_dir": "./references/auditors"
  },
  "modes": {
    "director-only": {
      "active_skills": [
        "design-director"
      ],
      "lazy_references": [
        "references/skills/*/BRIEF.md",
        "references/skills/*/PROFILE.md",
        "references/auditors/*/rules.yaml",
        "references/auditors/*/AUDITOR.md",
        "references/suite.yaml"
      ]
    }
  }
}
